# Copy to Koyeb dashboard env vars (click the + to add each)
# --- Database (Neon) ----------------------------------------------------
# From Neon: create project -> connect -> Prisma. Use the pooled URL if offered,
# otherwise append ?sslmode=require. Format:
# DATABASE_URL=postgresql://user:password@host.neon.tech/school_record_keeping?sslmode=require
DATABASE_URL=

# --- Auth -----------------------------------------------------------------
# REQUIRED in production (boot aborts if missing or the dev placeholder).
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- App ------------------------------------------------------------------
NODE_ENV=production
PORT=8080
CLIENT_URL=https://your-vercel-frontend-url.com
CORS_ORIGINS=

# --- Seed (Railway/Koyeb shell or one-off run) ------------------------------
ADMIN_EMAIL=admin@school.com
ADMIN_PASSWORD=change_this_before_seeding